# ============================================================
#  Configuración del entorno de pruebas de Ghost
#  Este archivo SÍ se sube al repositorio: es un entorno de
#  pruebas local y todas las credenciales son de prueba.
# ============================================================

# Nombre del proyecto Docker (prefijo de contenedores y volúmenes).
# Si levantas OTRA copia de este proyecto a la vez, cámbialo.
COMPOSE_PROJECT_NAME=ghost-blog

# ---- Versiones (fijas, para que todos tengan exactamente lo mismo) ----
GHOST_VERSION=6.69.0
MYSQL_VERSION=8.4.11
MAILPIT_VERSION=v1.27.0
ADMINER_VERSION=5.4.1

# ---- Puertos en tu ordenador ----
GHOST_PORT=2368
MAILPIT_PORT=8025
ADMINER_PORT=8082

# Dirección pública de Ghost. Debe usar el mismo puerto que GHOST_PORT.
GHOST_URL=http://localhost:2368

# ---- Base de datos (solo accesible dentro de Docker y por Adminer) ----
MYSQL_DATABASE=ghost
MYSQL_USER=ghost
MYSQL_PASSWORD=ghost_pruebas_db
MYSQL_ROOT_PASSWORD=root_pruebas_db

# ---- Verificación de dispositivo del staff ----
# true  = Ghost pide un código por correo al entrar desde un navegador nuevo
#         (el código llega a Mailpit). Útil para probar ese flujo.
# false = se entra solo con correo y contraseña (recomendado para automatizar).
STAFF_DEVICE_VERIFICATION=false

# ---- Datos de prueba que crea el seeder (servicio "seed") ----
SITE_TITLE=Ghost Pruebas
TEST_PASSWORD=Calidad.2026*Qa
